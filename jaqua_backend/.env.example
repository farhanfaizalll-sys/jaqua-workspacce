# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────
# Local dev example. On Render this is injected automatically from the
# linked database when using render.yaml (see fromDatabase in render.yaml).
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/jaqua?schema=public"

# ─── Auth (JWT) ───────────────────────────────────────────
# Generate a long random string in production, e.g. `openssl rand -hex 32`
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="7d"

# ─── MQTT broker ───────────────────────────────────────────
# Public test broker used during hardware bring-up. Swap for a private
# broker (with username/password) before real deployment — anyone who
# knows the topic name can read/write on a public broker.
MQTT_BROKER_URL="mqtt://broker.emqx.io:1883"
MQTT_USERNAME=
MQTT_PASSWORD=
